{
  "targets": [
    {
      "dir": "~/.agents/skills",
      "agents": ["cursor", "hermes", "codex"],
      "exclude": []
    },
    {
      "dir": "~/.claude/skills",
      "agents": ["claude"],
      "alsoReadBy": ["cursor"],
      "exclude": ["code-review"]
    },
    {
      "dir": "~/.openclaude/skills",
      "agents": ["openclaude"],
      "exclude": []
    }
  ],
  "builtins": {
    "claude": ["code-review"],
    "cursor": ["loop", "review", "goal", "shell"],
    "codex": ["imagegen", "openai-docs", "review-agent", "skill-creator", "skill-installer"]
  }
}
